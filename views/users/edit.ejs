<%- include('../partials/header') %>

<div class="container">
  <h1>Modifier <%= userDetail.username %></h1>
  <form action="/users/<%= encodeURIComponent(userDetail.email) %>?_method=PUT" method="POST">
    <label for="username">Nom d'utilisateur</label>
    <input type="text" id="username" name="username" value="<%= userDetail.username %>" minlength="3" required>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= userDetail.email %>" required>

    <label for="password">Nouveau mot de passe (laisser vide pour ne pas le changer)</label>
    <input type="password" id="password" name="password" minlength="6">
    
    <div class="row">
      <button type="submit">Enregistrer</button>
      <a class="delete-button" href="/users">Annuler</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
