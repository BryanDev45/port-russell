<%- include('../partials/header') %>

<div class="container">
  <h1>Modifier la réservation du catway <%= reservation.catwayNumber %></h1>
  <form action="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation._id %>?_method=PUT" method="POST">
    <label for="clientName">Nom du client</label>
    <input type="text" id="clientName" name="clientName" value="<%= reservation.clientName %>" required>

    <label for="boatName">Nom du bateau</label>
    <input type="text" id="boatName" name="boatName" value="<%= reservation.boatName %>" required>

    <label for="startDate">Date de début</label>
    <input type="date" id="startDate" name="startDate" value="<%= reservation.startDate.toISOString().slice(0, 10) %>" required>

    <label for="endDate">Date de fin</label>
    <input type="date" id="endDate" name="endDate" value="<%= reservation.endDate.toISOString().slice(0, 10) %>" required>

    <div class="row">
      <button type="submit">Enregistrer</button>
      <a class="delete-button" href="/reservations">Annuler</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
